{
  // Cloudflare Worker «enu»: статика сайта + API (/api/*) на D1.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enu",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Без database_id: при первом деплое wrangler сам создаст базу с этим именем
      "database_name": "enu-db"
    }
  ],
  "vars": {
    // Логины, которые при регистрации получают права администратора (через запятую)
    "ADMIN_USERNAMES": ""
  },
  "observability": { "enabled": true }
}
